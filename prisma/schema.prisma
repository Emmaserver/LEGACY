// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UnidadeMedida {
  UNIDADE
  KG
  METRO
  LITRO
  CAIXA
  SACO
}

enum Estado {
  ATIVO
  INATIVO
}

enum TipoCliente {
  PESSOA_FISICA
  EMPRESA
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
  AJUSTE
}

enum EstadoVenda {
  ATIVA
  CANCELADA
}

enum EstadoPagamento {
  PENDENTE
  PARCIAL
  PAGO
}

enum Papel {
  ADMINISTRADOR
  GERENTE
}

model Category {
  id        String    @id @default(cuid())
  nome      String    @unique
  estado    Estado    @default(ATIVO)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  produtos  Product[]

  @@map("categories")
}

model Product {
  id               String    @id @default(cuid())
  nome             String
  sku              String?   @unique
  unidade          UnidadeMedida
  precoCusto       Decimal   @db.Decimal(12, 2)
  precoVenda       Decimal   @db.Decimal(12, 2)
  estado           Estado    @default(ATIVO)
  quantidadeAtual  Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  movimentacoes    StockMovement[]
  itensVenda       SaleItem[]

  @@map("products")
}

model Client {
  id            String       @id @default(cuid())
  nome          String
  telefone      String
  documento     String?      @unique
  tipo          TipoCliente
  estado        Estado       @default(ATIVO)
  permiteFiado  Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  vendas        Sale[]

  @@map("clients")
}

model StockMovement {
  id          String            @id @default(cuid())
  tipo        TipoMovimentacao
  quantidade  Int
  motivo      String?
  createdAt   DateTime          @default(now())

  productId   String
  product     Product           @relation(fields: [productId], references: [id])

  @@map("stock_movements")
}

model Sale {
  id               String           @id @default(cuid())
  estado           EstadoVenda      @default(ATIVA)
  estadoPagamento  EstadoPagamento  @default(PENDENTE)
  valorTotal       Decimal          @db.Decimal(12, 2)
  valorPago        Decimal          @db.Decimal(12, 2) @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  clientId         String?
  client           Client?          @relation(fields: [clientId], references: [id])

  itens            SaleItem[]
  pagamentos       Payment[]

  @@map("sales")
}

model SaleItem {
  id              String   @id @default(cuid())
  quantidade      Int
  precoUnitario   Decimal  @db.Decimal(12, 2)

  saleId          String
  sale            Sale     @relation(fields: [saleId], references: [id])

  productId       String
  product         Product  @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model Payment {
  id          String   @id @default(cuid())
  valor       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id])

  @@map("payments")
}

model User {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  passwordHash String
  papel        Papel
  estado       Estado   @default(ATIVO)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
